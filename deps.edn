{:paths ["src/main/clojure" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.12.6"}}
 :aliases
 {:test {:extra-paths ["src/test/clojure"]
         :extra-deps {lambdaisland/kaocha {:mvn/version "1.91.1392"}}
         :main-opts ["-m" "kaocha.runner"]}
  :cljs {:extra-deps {org.clojure/clojurescript {:mvn/version "1.12.145"}}}
  :cljs-test {:extra-paths ["src/test/clojure"]
              :extra-deps {olical/cljs-test-runner {:mvn/version "3.8.1"}}
              :main-opts ["-m" "cljs-test-runner.main"
                          "-d" "src/test/clojure"
                          "-o" "target/cljs-test"]}
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2026.10.26"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src"]}
  :codox
  {:extra-deps {codox/codox {:mvn/version "0.10.8"}}
   :exec-fn codox.main/generate-docs
   :exec-args
   {:name "Namejen"
    :description "A Markov-chain-based name generator for games, fiction, &c."
    :source-paths ["src/main/clojure"]
    :output-path "doc/codox"
    :doc-paths []
    :source-uri
    "https://github.com/eigenhombre/namejen/blob/master/{filepath}#L{line}"}}
  :build {:deps {io.github.clojure/tools.build {:mvn/version "0.10.14"}
                 slipset/deps-deploy {:mvn/version "0.2.5"}}
          :ns-default build}}}
